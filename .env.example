# AI assistant configuration for TarefaMix
# Copy to .env and fill in your real values before running the backend.
PORT=3001
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here

# Optional: set to true to enable vector retrieval against Supabase when available.
USE_SUPABASE_VECTOR=false
